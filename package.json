{
  "name": "parkpilot",
  "version": "0.12.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite apps/web",
    "dev:worker": "wrangler dev",
    "build": "vite build apps/web",
    "typecheck": "tsc -p worker && tsc -p apps/web",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && npm run deploy:cloudflare",
    "deploy:cloudflare": "wrangler deploy && wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250910.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
